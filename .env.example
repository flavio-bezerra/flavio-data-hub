# Exemplo de configuração de variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env.local e preencha com seus valores:
#   cp .env.example .env.local

# Ponte de Integração HostGator / Vercel
HOSTGATOR_BRIDGE_TOKEN=

# Asaas Pagamentos (Sandbox / Homologação local)
ASAAS_PAYMENT_TOKEN=

# OpenRouter API (Acesso a modelos de IA / LLMs)
OPENROUTER_API_KEY=
OPENROUTE_SERVICE_TOKEN=

# Configuração de E-mail (SMTP)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@casamento-flavio-victoria.com.br
SMTP_PASSWORD=
EMAIL_FROM="Contato Casamento <contato@casamento-flavio-victoria.com.br>"
