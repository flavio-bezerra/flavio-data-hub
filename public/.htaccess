<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivo real (JS, CSS, imagens) é servido direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Asset que não existe precisa 404. Se cair no index.html, o navegador
  # tenta executar HTML como módulo e a página fica em branco.
  RewriteRule \.(?:js|mjs|css|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|json|webmanifest)$ - [NC,L]

  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>
